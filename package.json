{
  "name": "tide",
  "private": true,
  "version": "0.0.1",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "i18n": "node scripts/i18n-check.mjs",
    "i18n:scan": "node scripts/i18n-scan.mjs",
    "check:workflows": "node scripts/check-workflows.mjs",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml",
    "check:docs": "node scripts/check-ai-docs.mjs",
    "check": "pnpm i18n && pnpm i18n:scan && pnpm check:workflows && pnpm typecheck",
    "verify": "pnpm check && pnpm check:rust && pnpm check:docs",
    "preview": "vite preview",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build --debug --bundles app && node scripts/collect-app.mjs",
    "app:build:win": "tauri build --debug --bundles nsis && node scripts/collect-app.mjs",
    "app:release": "tauri build",
    "release:version": "node scripts/set-version.mjs",
    "release:check": "node scripts/release-check.mjs",
    "icon": "node scripts/make-icon.mjs && tauri icon assets/icon.png"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.0.0",
    "@codemirror/commands": "^6.0.0",
    "@codemirror/lang-cpp": "^6.0.0",
    "@codemirror/lang-css": "^6.0.0",
    "@codemirror/lang-go": "^6.0.0",
    "@codemirror/lang-html": "^6.0.0",
    "@codemirror/lang-java": "^6.0.0",
    "@codemirror/lang-javascript": "^6.0.0",
    "@codemirror/lang-json": "^6.0.0",
    "@codemirror/lang-markdown": "^6.0.0",
    "@codemirror/lang-python": "^6.0.0",
    "@codemirror/lang-rust": "^6.0.0",
    "@codemirror/lang-yaml": "^6.0.0",
    "@codemirror/language": "^6.0.0",
    "@codemirror/legacy-modes": "^6.0.0",
    "@codemirror/search": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "@lezer/highlight": "^1.0.0",
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-dialog": "^2.8.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^5.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.12.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "material-icon-theme": "^5.40.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^8.0.0"
  }
}
